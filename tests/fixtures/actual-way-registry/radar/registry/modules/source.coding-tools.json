{
  "schema": "way-content-registry/v1/module",
  "id": "source.coding-tools",
  "kind": "source",
  "enabled": true,
  "display": {
    "name": "AI Coding Tools catalogs",
    "category": "coding-tools",
    "target_path": "frontend/path/coding-tools"
  },
  "source": {
    "locator": "https://cursor.com/changelog/rss.xml",
    "vendors": [
      "cursor",
      "codex"
    ],
    "sources": [
      {"adapter": "rss_article", "feed_url": "https://cursor.com/changelog/rss.xml"},
      {"adapter": "llms_txt", "url": "https://cursor.com/llms.txt"},
      {"adapter": "rss_article", "feed_url": "https://cursor.com/atom.xml"},
      {"adapter": "rss_article", "feed_url": "https://cursor.com/blog/rss.xml"},
      {"adapter": "llms_txt", "url": "https://developers.openai.com/codex/llms.txt"},
      {"adapter": "llms_txt", "url": "https://developers.openai.com/blog/llms.txt"},
      {
        "adapter": "static_pages",
        "pages": [
          {
            "id": "codex-changelog",
            "title": "Codex Changelog",
            "url": "https://developers.openai.com/codex/changelog"
          }
        ]
      }
    ]
  },
  "bootstrap": {
    "mode": "adopt_existing",
    "baseline": "current_content"
  },
  "tasks": [
    {
      "id": "task.source.coding-tools.catalog",
      "kind": "index_sync",
      "adapter": "composite",
      "output": {
        "paths": [
          "frontend/sources/cursor",
          "frontend/sources/openai-codex",
          "frontend/path/coding-tools"
        ]
      },
      "schedule": {
        "enabled": true,
        "timezone": "Asia/Shanghai",
        "cron": "17 4 * * *",
        "retry_count": 2,
        "max_runtime_minutes": 30,
        "max_new_items": 0
      },
      "incremental": {
        "preserve_existing": true,
        "revision_field": "catalog.generatedAt"
      }
    }
  ]
}
