{
  "schema": "way-content-registry/v1/module",
  "id": "framework.cordis",
  "kind": "framework",
  "enabled": true,
  "parent_module_id": "framework.deepseek-harness",
  "display": {
    "name": "Cordis",
    "category": "agent-runtime",
    "target_path": "frontend/path/frameworks/02-agent-runtime/deepseek-harness/cordis"
  },
  "source": {
    "github": "cordiverse/cordis",
    "deepwiki": "https://deepwiki.com/cordiverse/cordis"
  },
  "bootstrap": {
    "mode": "adopt_existing",
    "baseline": "current_content"
  },
  "tasks": [
    {
      "id": "task.framework.cordis.wiki",
      "kind": "wiki_sync",
      "adapter": "deepwiki",
      "source": {
        "legacy_id": "cordis",
        "github": "cordiverse/cordis"
      },
      "output": {
        "path": "frontend/path/frameworks/02-agent-runtime/deepseek-harness/cordis/wiki"
      },
      "schedule": {
        "enabled": true,
        "timezone": "Asia/Shanghai",
        "cron": "17 4 * * *",
        "retry_count": 2,
        "max_runtime_minutes": 30,
        "max_new_items": 50
      },
      "incremental": {
        "authority": "github_tree",
        "preserve_existing": true
      }
    },
    {
      "id": "task.framework.cordis.index",
      "kind": "index_sync",
      "adapter": "framework_hubs",
      "depends_on": [
        "task.framework.cordis.wiki"
      ],
      "output": {
        "path": "frontend/path/frameworks/hubs.json"
      },
      "schedule": {
        "enabled": true,
        "timezone": "Asia/Shanghai",
        "cron": "57 4 * * *",
        "retry_count": 1,
        "max_runtime_minutes": 10,
        "max_new_items": 0
      },
      "incremental": {
        "preserve_existing": true
      }
    }
  ]
}
