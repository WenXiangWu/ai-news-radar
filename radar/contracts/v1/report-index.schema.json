{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-report-index/v1",
  "title": "Radar daily report index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "reports"],
  "properties": {
    "schema": {"const": "radar-report-index/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "status", "generated_at", "summary", "path"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "status": {"type": "string"},
          "generated_at": {"type": "string", "format": "date-time"},
          "summary": {"type": "object"},
          "path": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}
