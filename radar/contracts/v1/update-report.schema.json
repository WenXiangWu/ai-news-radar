{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-update-report/v1",
  "title": "Radar module update report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "generated_at", "status", "summary", "verification", "source_validation", "modules"],
  "properties": {
    "schema": {"const": "radar-update-report/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "pending", "partial", "failed"]},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "verification": {"type": "object"},
    "source_validation": {"type": "object"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "name", "kind", "enabled", "status", "updated", "translated", "translation_links", "errors"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "status": {"type": "string", "minLength": 1},
          "updated": {"type": "integer", "minimum": 0},
          "translated": {"type": "integer", "minimum": 0},
          "translation_links": {"type": "array"},
          "errors": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  }
}
