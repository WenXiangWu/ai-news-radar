{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-source-validation/v1",
  "title": "Radar source validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "status", "counts", "sources", "errors", "live"],
  "properties": {
    "schema": {"const": "radar-source-validation/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "failed"]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "module_id", "adapter", "status", "health", "baseline_status", "cursor_status", "errors"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "module_id": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "status": {"enum": ["ok", "failed"]},
          "health": {"type": "object"},
          "baseline_status": {"type": "string", "minLength": 1},
          "cursor_status": {"type": "string", "minLength": 1},
          "errors": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "live": {"type": "boolean"}
  }
}
